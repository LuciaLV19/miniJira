{
	"name": "minijira-root",
	"private": true,
	"pnpm": {
		"onlyBuiltDependencies": [
			"mongodb-memory-server"
		]
	},
	"scripts": {
		"dev": "concurrently \"pnpm --dir backend dev\" \"pnpm --dir frontend dev\"",
		"dev:frontend": "pnpm --dir frontend dev",
		"dev:backend": "pnpm --dir backend dev",
		"lint": "pnpm --dir frontend lint && pnpm --dir backend lint",
		"typecheck": "pnpm --dir frontend typecheck",
		"test": "pnpm --dir frontend test && pnpm --dir backend test",
		"check-types": "pnpm --dir frontend typecheck"
	},
	"dependencies": {
		"axios": "^1.19.0",
		"morgan": "^1.11.0"
	},
	"devDependencies": {
		"concurrently": "^10.0.4"
	}
}